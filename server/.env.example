# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL). Leave blank during local dev to allow all origins.
# Example: CORS_ORIGIN=https://atozweldandbuild.com,https://www.atozweldandbuild.com
CORS_ORIGIN=

# Where contact form submissions are sent
TO_EMAIL=atozweldbuild@gmail.com

# SMTP credentials used to SEND the email.
# For Gmail: enable 2-Step Verification, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
